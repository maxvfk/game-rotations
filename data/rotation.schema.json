{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://maxvfk.github.io/game-rotations/rotation.schema.json",
  "title": "Game Rotations team document v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "id",
    "game",
    "title",
    "gameVersion",
    "source",
    "verificationNote",
    "characters",
    "controls",
    "defaultSlots",
    "variants",
    "stages"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "id": {
      "$ref": "#/$defs/id"
    },
    "game": {
      "$ref": "#/$defs/id"
    },
    "title": {
      "$ref": "#/$defs/nonempty"
    },
    "gameVersion": {
      "$ref": "#/$defs/nonempty"
    },
    "source": {
      "type": "string",
      "format": "uri"
    },
    "verificationNote": {
      "$ref": "#/$defs/nonempty"
    },
    "controls": {
      "$ref": "#/$defs/id"
    },
    "defaultSlots": {
      "type": "object",
      "minProperties": 2,
      "additionalProperties": {
        "type": "string",
        "minLength": 1
      }
    },
    "characters": {
      "type": "array",
      "minItems": 2,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "name",
          "glyph",
          "color",
          "portrait",
          "investment"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "name": {
            "$ref": "#/$defs/nonempty"
          },
          "glyph": {
            "$ref": "#/$defs/nonempty"
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9A-Fa-f]{6}$"
          },
          "portrait": {
            "type": "string",
            "pattern": "^portraits/[a-zA-Z0-9_-]+\\.(webp|png|jpg)$"
          },
          "investment": {
            "$ref": "#/$defs/nonempty"
          }
        }
      }
    },
    "variants": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "sub",
          "type",
          "intro",
          "verification",
          "opener",
          "loop"
        ],
        "properties": {
          "id": {
            "$ref": "#/$defs/id"
          },
          "label": {
            "$ref": "#/$defs/nonempty"
          },
          "sub": {
            "$ref": "#/$defs/nonempty"
          },
          "type": {
            "$ref": "#/$defs/nonempty"
          },
          "intro": {
            "$ref": "#/$defs/nonempty"
          },
          "verification": {
            "enum": [
              "adapted",
              "partial",
              "experimental",
              "verified"
            ]
          },
          "opener": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          },
          "loop": {
            "type": "array",
            "minItems": 1,
            "items": {
              "$ref": "#/$defs/id"
            }
          }
        }
      }
    },
    "stages": {
      "type": "object",
      "minProperties": 1,
      "patternProperties": {
        "^[A-Za-z][A-Za-z0-9]*$": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "person",
            "title",
            "sub",
            "actions",
            "check",
            "extra"
          ],
          "properties": {
            "person": {
              "$ref": "#/$defs/id"
            },
            "title": {
              "$ref": "#/$defs/nonempty"
            },
            "sub": {
              "$ref": "#/$defs/nonempty"
            },
            "check": {
              "$ref": "#/$defs/nonempty"
            },
            "extra": {
              "type": "string"
            },
            "actions": {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "object",
                "additionalProperties": false,
                "required": [
                  "text",
                  "tone",
                  "input"
                ],
                "properties": {
                  "text": {
                    "$ref": "#/$defs/nonempty"
                  },
                  "tone": {
                    "enum": [
                      "normal",
                      "key",
                      "vital",
                      "swap",
                      "flow",
                      "sensitive"
                    ]
                  },
                  "input": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": [
                      "kind"
                    ],
                    "properties": {
                      "kind": {
                        "enum": [
                          "intro",
                          "outro",
                          "swap",
                          "basic",
                          "heavy",
                          "skill",
                          "ultimate",
                          "echo",
                          "dodge",
                          "auto"
                        ]
                      },
                      "count": {
                        "type": "integer",
                        "minimum": 2,
                        "maximum": 20
                      },
                      "repeat": {
                        "type": "boolean"
                      },
                      "target": {
                        "$ref": "#/$defs/id"
                      }
                    }
                  }
                }
              }
            }
          }
        }
      },
      "additionalProperties": false
    }
  },
  "$defs": {
    "nonempty": {
      "type": "string",
      "minLength": 1
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    }
  }
}
