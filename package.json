{
  "name": "game-rotations",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "npm run catalog:check && npm run validate:data && npm run test:arts-checkpoints && npm run validate:physical && npm run validate:portraits && npm run test:onboarding && npm run test:authoring && npm run test:renderer && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "validate:data": "node scripts/validate-rotations.mjs",
    "test:onboarding": "node scripts/test-onboarding.mjs",
    "validate:portraits": "node scripts/validate-portraits.mjs",
    "test:renderer": "vitest run test/rotation-renderer.test.ts test/arts-indicators.test.ts test/arts-checkpoint-view.test.ts test/physical-indicators.test.ts",
    "test:e2e": "playwright test",
    "team:add": "node scripts/team-authoring.mjs add",
    "catalog:sync": "node scripts/team-authoring.mjs sync",
    "catalog:check": "node scripts/team-authoring.mjs sync --check",
    "test:authoring": "node scripts/test-team-authoring.mjs",
    "test:arts-checkpoints": "node scripts/test-arts-checkpoints.mjs",
    "validate:physical": "node scripts/validate-endfield-physical.mjs"
  },
  "devDependencies": {
    "vite": "^7.1.0",
    "typescript": "^5.9.0",
    "vite-plugin-pwa": "^1.0.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "vitest": "^3.2.4",
    "jsdom": "^26.1.0",
    "@playwright/test": "^1.56.0"
  }
}
